# tema escolhido no navegador daquela máquina.
FPSO-Optimization_V1/log/
FPSO-Optimization_V1/app/log/
FPSO-Optimization_V1/.theme

# NOTA: flake.nix, flake.lock e Manifest.toml são versionados DE PROPÓSITO —
